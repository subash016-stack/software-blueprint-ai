# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=qwen2.5:3b
FALLBACK_GENERATION_MODEL=
EMBEDDING_MODEL=qwen3-embedding:0.6b
FALLBACK_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.0

# Redis Cache (supports automatic in-memory fallback)
REDIS_URL=redis://localhost:6379
ENABLE_REDIS=true
CACHE_TTL_SECONDS=86400

# Qdrant Vector Store (supports automatic in-memory fallback)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=software_engineering_knowledge

# Database Persistence (supports SQLite and PostgreSQL)
DATABASE_URL=sqlite:///./software_blueprint.db

# Prompt Version Fingerprints
REQUIREMENT_PROMPT_VERSION=1.0
PLANNING_PROMPT_VERSION=1.0
ARCHITECTURE_PROMPT_VERSION=1.0
RAG_PROMPT_VERSION=1.0
VALIDATION_PROMPT_VERSION=1.0
IMPACT_PROMPT_VERSION=1.0
SCHEMA_VERSION=1.0
